# ------------------------------------------------------------------
# MedicsPro / CRM Fisioterapia — Variáveis de Ambiente (Front-end)
# Copie para .env.local ao integrar o back-end. Nunca commite .env!
# ------------------------------------------------------------------

# Supabase self-hosted (MedicsPro)
# URL pública do Supabase (já configurada via Traefik)
VITE_SUPABASE_URL=https://supabase.medicspro.com.br

# ANON_KEY: obtida no Supabase Studio → Project Settings → API
# Esta chave é segura para uso no frontend (acesso limitado por RLS)
VITE_SUPABASE_ANON_KEY=<anon_key_do_supabase>

# API principal (NestJS) — futuro backend
VITE_API_URL=http://localhost:3333

# WebSocket da agenda em tempo real
VITE_WS_URL=ws://localhost:3333/agenda

# Mensageria — Evolution API (self-hosted) ou Meta Cloud API
VITE_WHATS_PROVIDER=evolution
VITE_WHATS_API_URL=
VITE_WHATS_API_KEY=

# Pagamentos — Asaas ou Mercado Pago (split para repasse)
VITE_PAYMENTS_GATEWAY=asaas
VITE_PAYMENTS_API_KEY=

# Assinatura digital — Clicksign (opcional)
VITE_CLICKSIGN_TOKEN=

# Observabilidade
VITE_SENTRY_DSN=
