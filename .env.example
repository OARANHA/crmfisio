# ------------------------------------------------------------------
# Projeto Coração — variáveis de ambiente (front-end)
# Copie para .env.local ao integrar o back-end. Nunca commite .env!
# ------------------------------------------------------------------

# API principal (NestJS)
VITE_API_URL=http://localhost:3333

# WebSocket da agenda em tempo real
VITE_WS_URL=ws://localhost:3333/agenda

# Mensageria — Evolution API (self-hosted) ou Meta Cloud API
VITE_WHATS_PROVIDER=evolution
VITE_WHATS_API_URL=
VITE_WHATS_API_KEY=

# Pagamentos — Asaas ou Mercado Pago (split para repasse)
VITE_PAYMENTS_GATEWAY=asaas
VITE_PAYMENTS_API_KEY=

# Assinatura digital — Clicksign (opcional)
VITE_CLICKSIGN_TOKEN=

# Observabilidade
VITE_SENTRY_DSN=
